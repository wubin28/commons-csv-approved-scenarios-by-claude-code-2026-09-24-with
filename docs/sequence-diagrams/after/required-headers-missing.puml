@startuml
title Required header missing: parser construction rejects before first data record
autonumber
actor "RequiredHeadersContractTest\nshouldRejectDuringParserConstructionIfPhysicalHeaderIsMissing" as Test
participant "CSVFormat.Builder" as Builder
participant "CSVFormat" as Format
participant "CSVParser.parse(String, format)" as Parse
participant "CSVParser.Builder" as ParserBuilder
participant "CSVParser" as Parser
participant "Lexer" as Lexer

Test -> Builder : setHeader("account_id", "currency")\nsetSkipHeaderRecord(true)\nsetRequiredHeaders("currency")
Builder -> Format : get() / construct and validate configuration
Format --> Test : format
Test -> Parse : parse("account_id,amount\\nA-001,12.50\\n", format)
Parse -> ParserBuilder : builder().setReader(StringReader).setFormat(format).get()
ParserBuilder -> Parser : new CSVParser(reader, format, ...)
Parser -> Parser : createHeaders()
Parser -> Parser : nextRecord() reads physical header
Parser -> Lexer : nextToken(reusableToken) for header cells
Lexer --> Parser : tokens account_id, amount
Parser --> Parser : CSVRecord [account_id, amount]
Parser -> Parser : build explicit mapping [account_id, currency]
Parser -> Parser : validateRequiredHeaders(physicalHeader, true)
note right of Parser
  physical names omit currency;
  data row A-001,12.50 is not read.
end note
Parser --> ParserBuilder : throws IllegalArgumentException\n"Missing required CSV headers: [currency]"
ParserBuilder --> Parse : propagates exception
Parse --> Test : assertThrows catches exception
@enduml
