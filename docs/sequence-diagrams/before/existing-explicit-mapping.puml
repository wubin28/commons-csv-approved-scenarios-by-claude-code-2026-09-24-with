@startuml
title S2 existing flow: explicit mapping reads amount as currency
autonumber
actor "RequiredHeadersExistingFlowE2ETest" as Test
participant "CSVFormat.Builder" as Builder
participant "CSVParser.parse(URL, charset, format)" as Parse
participant "CSVParser" as Parser
participant "CSVRecord" as Record
Test -> Builder : setHeader("account_id", "currency")\nsetSkipHeaderRecord(true).get()
Builder --> Test : format without required headers
Test -> Parse : parse(reconciliation-missing-currency.csv, UTF_8, format)
Parse -> Parser : construct / createHeaders()
Parser -> Parser : nextRecord() consumes [account_id, amount]
Parser -> Parser : map declared [account_id, currency]
Parser --> Test : parser
Test -> Parser : iterator().next()
Parser --> Test : record [A-001, 12.50]
Test -> Record : get("account_id")
Record --> Test : A-001
Test -> Record : get("currency")
Record --> Test : 12.50
note right of Test : Business map = {A-001=12.50}
@enduml
